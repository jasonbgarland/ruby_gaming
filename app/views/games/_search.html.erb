<%# Generic game search: a form plus IGDB results. Only the results live in the
    Turbo Frame; the form sits outside it and targets the frame, so a search
    swaps the results without replacing the text box (which would lose the
    cursor while typing). A Stimulus controller submits the form after a
    pause in typing (once there are at least 3 characters, to go easy on
    IGDB's rate limit). Pressing Enter or the Search button always searches,
    whatever the length.

    Locals:
      url            - where the search form GETs to (the calling page)
      query          - the current search text (may be nil)
      results        - Array of IgdbClient::Game for that query
      action_partial - partial rendered once per result for the caller's
                       own action (add to collection, write a review, ...).
                       It receives `result` and `query` locals. %>
<%= form_with url: url, method: :get, class: "game-search-form",
      data: { turbo_frame: "game-search", controller: "autosubmit",
              autosubmit_min_length_value: 3,
              action: "submit->autosubmit#cancel" } do %>
  <%= label_tag :q, "Game name", class: "sr-only" %>
  <%= text_field_tag :q, query, placeholder: "Search for a game…", autocomplete: "off",
        data: { action: "input->autosubmit#submit" } %>
  <%= submit_tag "Search" %>
<% end %>

<%= turbo_frame_tag "game-search" do %>
  <% if query.present? %>
    <% if results.empty? %>
      <p>No results for &ldquo;<%= query %>&rdquo;.</p>
    <% else %>
      <ul class="game-results">
        <% results.each do |result| %>
          <li class="game-result">
            <% if result.cover_url %>
              <%= image_tag result.cover_url, alt: result.name, class: "game-cover" %>
            <% end %>
            <div class="game-result-details">
              <h3><%= link_to result.name, game_path(result.igdb_id), data: { turbo_frame: "_top" } %></h3>
              <p class="game-result-meta">
                <% if result.release_date %>
                  <%= result.release_date.year %>
                <% end %>
                <% if result.platforms.present? %>
                  &middot; <%= result.platforms.map { |platform| platform_label(platform) }.join(", ") %>
                <% end %>
              </p>
              <%= render partial: action_partial, locals: { result: result, query: query } %>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
<% end %>

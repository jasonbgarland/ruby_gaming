<%= tag.div(flash[:alert], class: "flash flash-alert") if flash[:alert] %>
<%= tag.div(flash[:notice], class: "flash flash-notice") if flash[:notice] %>

<%= render "games/panel", game: @game %>
<p class="attribution">
  Game details sourced from
  <%= @game.igdb_url.present? ? link_to("IGDB", @game.igdb_url) : "IGDB" %>.
</p>
<%= render "games/rating", game: @game, rating: @rating %>
<%= render "games/reviews", game: @game, my_review: @my_review, short_reviews: @short_reviews, reviews_count: @reviews_count,
    ratings_by_user: @ratings_by_user %>
<%= render "games/your_stuff", game: @game, collection_games: @collection_games, collections: @collections %>

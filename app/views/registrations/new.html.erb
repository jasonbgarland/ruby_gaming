<h1>Sign up</h1>

<%= render "shared/errors", model: @user %>

<%= form_with model: @user, url: registration_path do |form| %>
  <div class="field">
    <%= form.label :first_name %>
    <%= form.text_field :first_name, required: true, autofocus: true %>
  </div>
  <div class="field">
    <%= form.label :last_name %>
    <%= form.text_field :last_name, required: true %>
  </div>
  <div class="field">
    <%= form.label :username %>
    <%= form.text_field :username, required: true, maxlength: 20 %>
  </div>
  <div class="field">
    <%= form.label :email_address, "Email address" %>
    <%= form.email_field :email_address, required: true, autocomplete: "username" %>
  </div>
  <div class="field">
    <%= form.label :password %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %>
  </div>
  <div class="field">
    <%= form.label :password_confirmation %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
  </div>
  <%= form.submit "Create account" %>
<% end %>

<p>Already have an account? <%= link_to "Log in", new_session_path %></p>

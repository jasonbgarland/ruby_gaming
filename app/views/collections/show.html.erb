<p><%= link_to "&larr; My collections".html_safe, collections_path %></p>

<%= tag.div(flash[:alert], class: "flash flash-alert") if flash[:alert] %>
<%= tag.div(flash[:notice], class: "flash flash-notice") if flash[:notice] %>

<h1><%= @collection.title %></h1>
<p><%= link_to "Edit", edit_collection_path(@collection) %></p>
<%= button_to "Delete", collection_path(@collection), method: :delete,
      form: { data: { turbo_confirm: "Delete “#{@collection.title}” and everything in it?" } } %>
<%= tag.p(@collection.description) if @collection.description.present? %>

<% if @collection_games.empty? %>
  <p>No games in this collection yet.</p>
<% else %>
  <ul class="game-results">
    <% @collection_games.each do |collection_game| %>
      <% game = collection_game.game %>
      <li class="game-result">
        <% if game.cover_url %>
          <%= image_tag game.cover_url, alt: game.name, class: "game-cover" %>
        <% end %>
        <div class="game-result-details">
          <h3><%= game.name %></h3>
          <p><%= collection_game.platform %></p>
          <%= button_to "Remove", collection_collection_game_path(@collection, collection_game), method: :delete %>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>

<h2>Add a game</h2>
<%= render "games/search", url: collection_path(@collection), query: @query, results: @results,
      action_partial: "collection_games/add_result" %>

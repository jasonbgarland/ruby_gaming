<h1>My collections</h1>

<p><%= link_to "New collection", new_collection_path %></p>

<% if @collections.empty? %>
  <p>You don&rsquo;t have any collections yet.</p>
<% else %>
  <ul class="collections">
    <% @collections.each do |collection| %>
      <li class="collection">
        <h3><%= link_to collection.title, collection_path(collection) %></h3>
        <%= tag.p(collection.description) if collection.description.present? %>
      </li>
    <% end %>
  </ul>
<% end %>

<%= tag.div(flash[:alert], class: "flash flash-alert") if flash[:alert] %>
<%= tag.div(flash[:notice], class: "flash flash-notice") if flash[:notice] %>

<p><%= link_to "← #{@game.name}", game_path(@game.igdb_id) %></p>

<h1>Reviews of <%= @game.name %></h1>

<p>
  <% if @my_review %>
    <%= link_to "Edit your review", edit_game_review_path(@game.igdb_id, @my_review) %>
  <% else %>
    <%= link_to "Write your review", new_game_review_path(@game.igdb_id) %>
  <% end %>
</p>

<% if @reviews.empty? %>
  <p class="review-empty">No reviews yet. Be the first.</p>
<% else %>
  <ul class="reviews">
    <% @reviews.each do |review| %>
      <li class="review card">
        <%# The body is plain text: ERB escapes it, and CSS keeps its line breaks. %>
        <% if review.title.present? %>
          <h2 class="review-title"><%= review.title %></h2>
        <% end %>
        <p class="review-meta">
          <%= review.user.username %> · <%= l review.created_at.to_date, format: :long %>
          <%= rating_stars(@ratings_by_user[review.user_id]) if @ratings_by_user[review.user_id] %>
          <% if review.long? %><span class="badge">Long review</span><% end %>
          <% if review.hidden? %><span class="badge">Hidden</span><% end %>
        </p>
        <div class="review-body"><%= review_body(review) %></div>
        <% if review.user_id == Current.user.id %>
          <p class="review-actions">
            <%= link_to "Edit", edit_game_review_path(@game.igdb_id, review) %>
            <%= button_to "Delete", game_review_path(@game.igdb_id, review), method: :delete,
                  class: "button-quiet", form: { class: "inline-form", data: { turbo_confirm: "Delete your review?" } } %>
          </p>
        <% end %>
        <%= render "reviews/report", game: @game, review: review, reported: @reported_review_ids.include?(review.id) %>
      </li>
    <% end %>
  </ul>
<% end %>
